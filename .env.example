# Higgsfield AI Credentials
# Obtenha em https://higgsfield.ai ou via `higgsfield auth login`

# Formato Unificado V2 (Recomendado)
HF_CREDENTIALS=YOUR_KEY_ID:YOUR_KEY_SECRET

# Formato Separado V1
# HF_API_KEY=YOUR_KEY_ID
# HF_API_SECRET=YOUR_KEY_SECRET

# URL Base da API (Opcional, padrão: https://api.higgsfield.ai)
# HF_BASE_URL=https://api.higgsfield.ai
